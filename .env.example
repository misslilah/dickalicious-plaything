# Supabase — Project Settings → API
# URL: no trailing slash, must be https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://xxxx.supabase.co

# Public client key (either format works with @supabase/supabase-js):
# - Legacy anon key (JWT, starts with eyJ)
# - Publishable key (starts with sb_publishable_)
# Do NOT use the service role / secret key here.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: client max upload size in bytes (default 2GB)
# VITE_MAX_VIDEO_BYTES=2147483648

# Patreon membership page (upgrade link in video paywall)
# VITE_PATREON_PAGE_URL=https://www.patreon.com/your-creator-page

# Throne creator wishlist page (floating bubble above Patreon)
# VITE_THRONE_URL=https://throne.com/u/your-username
